# Скопируйте в .env и заполните. НИКОГДА не коммитьте .env

# --- Приложение ---
DEBUG=false

# --- База данных ---
# SQLite (тест): sqlite+aiosqlite:///./sla_planner.db
# PostgreSQL (прод): postgresql+asyncpg://user:pass@localhost:5432/sla_planner
DATABASE_URL=sqlite+aiosqlite:///./sla_planner.db

# --- Zabbix JSON-RPC API ---
ZABBIX_URL=http://localhost:8080/api_jsonrpc.php
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix
# На проде: true (портал только читает). false — разрешает sla.update
ZABBIX_READ_ONLY=true

# --- JWT портала ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
